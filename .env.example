# Which LLM to use: "anthropic" (default, paid) or "openai" (any OpenAI-compatible
# endpoint -- Ollama, Groq, OpenRouter -- including free options).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only set this if you explicitly want non-default sampling; many current
# models reject temperature entirely, so it is NOT sent unless set here.
# ANTHROPIC_TEMPERATURE=0

MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT_MS=45000
API_RETRIES=2

PORT=3000
# Set to "1" if deployed behind exactly one reverse proxy (Render, Heroku,
# nginx), so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=

RATE_LIMIT_PER_15MIN=20
MAX_DAILY_REQUESTS=500

# --- Free / open-source option: LLM_PROVIDER=openai ---
# Local with Ollama (free, no key; run `ollama pull qwen2.5:7b` first):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5:7b
# Groq free tier (needs a key from console.groq.com):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=your_key
#   OPENAI_MODEL=<a model Groq currently offers, e.g. a Llama or Qwen variant>
# Local models are slower: consider REQUEST_TIMEOUT_MS=120000.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
